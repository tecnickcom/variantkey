exclude .gitignore
exclude .coverage
exclude .coveragerc
exclude .travis.yml
include setup.cfg
# NOTE: these paths must stay inside the package. "include ../c/src/..." was
# silently ignored by setuptools, which is why the sdist shipped without a single
# C header and could not be built. setup.py stages the files here first.
include README.md
include LICENSE
recursive-include c/src/variantkey *.h
include variantkey/pyvariantkey.h
prune .cache
prune .git
prune build
prune dist
prune htmlcov
recursive-exclude *.egg-info *
recursive-include test *
# NOTE: keep these last - MANIFEST.in directives are applied in order, so an
# earlier exclude would be undone by the recursive-include above.
global-exclude *.py[cod]
global-exclude __pycache__/*
